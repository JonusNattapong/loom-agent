{
  "name": "loom",
  "private": true,
  "version": "1.1.0",
  "description": "A local durable multi-agent harness with task graphs and verified execution.",
  "workspaces": [
    "packages/*",
    "packages/bots"
  ],
  "scripts": {
    "build": "tsc -b && npm -w @loom-agent/web run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx packages/evals/src/cli.ts",
    "dev": "tsx watch packages/cli/src/index.ts repl",
    "start": "npm run loom -- repl",
    "check:packages": "node scripts/check-package-graph.mjs",
    "release:version": "changeset version",
    "release:publish": "npm run build && npm publish --workspaces --access public --provenance",
    "loom": "tsx packages/cli/src/index.ts",
    "test:web": "npm -w @loom-agent/web test"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
