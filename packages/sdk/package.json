{
  "dependencies": {
    "@loom/core": "^1.1.0",
    "@loom/providers": "^1.1.0",
    "@loom/skills": "^1.1.0",
    "@loom/state": "^1.1.0",
    "@loom/tools": "^1.1.0"
  },
  "description": "Public developer SDK for the Loom agent platform: define agents, tools, skills, and run them locally or remotely through stable contracts.",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./contracts": {
      "import": "./dist/contracts.js",
      "types": "./dist/contracts.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "contracts.d.ts"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "name": "@loom/sdk",
  "peerDependencies": {
    "@loom/adaptive": "^1.1.0",
    "@loom/bots": "^1.1.0",
    "@loom/context": "^1.1.0",
    "@loom/control": "^1.1.0",
    "@loom/coordinator": "^1.1.0",
    "@loom/daemon": "^1.1.0",
    "@loom/network": "^1.1.0",
    "@loom/remote": "^1.1.0",
    "@loom/runtime": "^1.1.0"
  },
  "peerDependenciesMeta": {
    "@loom/adaptive": {
      "optional": true
    },
    "@loom/bots": {
      "optional": true
    },
    "@loom/context": {
      "optional": true
    },
    "@loom/control": {
      "optional": true
    },
    "@loom/coordinator": {
      "optional": true
    },
    "@loom/daemon": {
      "optional": true
    },
    "@loom/network": {
      "optional": true
    },
    "@loom/remote": {
      "optional": true
    },
    "@loom/runtime": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonusNattapong/loom-agent.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "1.1.0"
}
